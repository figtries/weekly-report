# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Two URLs are needed locally (only POOLER goes on Vercel).
#
# 1. Direct connection — used by drizzle-kit and local development.
#    Dashboard → Project Settings → Database → "Direct connection" (port 5432)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
#
# 2. Transaction pooler — used on Vercel (many lambdas share the pool).
#    Dashboard → Project Settings → Database → "Transaction" (port 6543)
DATABASE_URL_POOLER=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# A random secret used to seal auth tokens and derive encryption keys.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# ─── App ─────────────────────────────────────────────────────────────────────
# Full URL of the app (used for auth callback redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Redis (Upstash) — for daily reports + photo storage ─────────────────────
# Optional on a local machine (falls back to filesystem).
# Required on Vercel to persist the JSON workspace across lambdas.
# Get from: Upstash Console → Database → REST API
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── PDF Generation ──────────────────────────────────────────────────────────
# Optional: override Next.js build output directory (rarely needed)
# NEXT_DIST_DIR=.next
#
# Chromium binary URL for @sparticuz/chromium-min (downloaded at cold start).
# Default points to the GitHub release; set to an S3/R2 URL for faster cold starts.
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v153.0.0/chromium-v153.0.0-pack.x64.tar
