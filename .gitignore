# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Preview build dirs (NEXT_DIST_DIR=.next-preview, .next-preview2, …) — one per
# concurrent dev/preview server. Pure build cache, regenerated on demand.
/.next-preview*/
/.next-buildcheck/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# the prototype database — a file you can copy, but never one to commit.
# Recreate it with: npm run db:migrate
/data/report.db
/data/report.db-shm
/data/report.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env.local
/.next-verify/
.next-dev*.log

# Kembaran database untuk melihat layar register kosong (scripts/make-empty-db.mjs)
/data/empty.db*
/.next-empty/

# Salinan database sebelum tiap migrasi drizzle (lihat AGENTS.md) — bukan kode,
# dan 1,8 MB per berkas. Dibuat manual, dibuang manual.
/data/report.db.before-*
/data/db.json.bak

# Skill klon terpisah (punya .git sendiri) — bukan bagian aplikasi ini.
/excalidraw-diagram-skill/

# Sisi-berkas WAL dari snapshot; snapshot-nya sendiri (data/seed.db) ikut di-commit.
/data/seed.db-shm
/data/seed.db-wal
